# ---------------------------------------------------------------------------
# Target / flash / PSRAM: ESP32-S3 N16R8 (16 MB QIO flash, 8 MB octal PSRAM)
# ---------------------------------------------------------------------------
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ---------------------------------------------------------------------------
# Firmware update from the configuration portal (two OTA slots, see partitions.csv).
# A new firmware starts on trial: if it resets before the application confirms it (60 s after
# start, main/app_main.cpp), the bootloader goes back to the previous one. Needs this bootloader:
# devices upgraded with the app file only keep their old bootloader and update without rollback.
# ---------------------------------------------------------------------------
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---------------------------------------------------------------------------
# Unattended device: a hang ends in a restart, and the reason can be read afterwards.
# ---------------------------------------------------------------------------
# A task that keeps a CPU for 15 s (the idle task never runs) panics and restarts the device;
# the default only prints a warning on the serial port and stays hung.
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
# The panic handler stores a core dump in the "coredump" partition (partitions.csv). Only its
# summary (task, addresses, cause) is shown on the diagnostics page; see app_state.h.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
# Own stack for writing it: the crashed task may have none left (stack overflow).
CONFIG_ESP_COREDUMP_STACK_SIZE=1792
# Stack margin of every task on the diagnostics page (uxTaskGetSystemState).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# ---------------------------------------------------------------------------
# Matter: server (thermostat) + commissioner on the same CHIP stack
# ---------------------------------------------------------------------------
CONFIG_ESP_MATTER_ENABLE_MATTER_SERVER=y
# Builds connectedhomeip src/controller (DeviceCommissioner, AutoCommissioner, ...).
# ESP_MATTER_COMMISSIONER_ENABLE is NOT used: its Kconfig depends on !ESP_MATTER_ENABLE_MATTER_SERVER.
CONFIG_ENABLE_CHIP_CONTROLLER_BUILD=y
CONFIG_ESP_MATTER_CONTROLLER_ENABLE=n
# Required: CHIP_CONFIG_UNSAFE_SUBSCRIPTION_EXCHANGE_MANAGER_USE (set in matter_project_config.h)
# dereferences a null ExchangeManager for *resumed* subscriptions, so persistence must be off.
CONFIG_ENABLE_PERSIST_SUBSCRIPTIONS=n
CONFIG_CHIP_PROJECT_CONFIG="main/matter_project_config.h"

# Unique per-device setup passcode/discriminator generated on first boot (see device_identity.cpp)
CONFIG_CUSTOM_COMMISSIONABLE_DATA_PROVIDER=y
# No fallback to the SDK's well-known test passcode/discriminator (20202021 / 3840) anywhere.
CONFIG_ENABLE_TEST_SETUP_PARAMS=n
# Test DAC (uncertified product). Use esp-matter-mfg-tool + factory partition for real DACs.
CONFIG_EXAMPLE_DAC_PROVIDER=y

# Commissioning window is opened by the application (only when no home fabric exists).
CONFIG_CHIP_ENABLE_PAIRING_AUTOSTART=n

# DNS-SD commissionable advertisement: "DN" (device name with version, matter_project_config.h)
# and "DT" = Thermostat (0x0301) so commissioners can show what they found.
CONFIG_ENABLE_COMMISSIONABLE_DEVICE_TYPE=y
CONFIG_DEVICE_TYPE=769

CONFIG_MAX_FABRICS=6
CONFIG_MAX_EXCHANGE_CONTEXTS=16
CONFIG_MAX_UNSOLICITED_MESSAGE_HANDLERS=10
CONFIG_NUM_UDP_ENDPOINTS=20
CONFIG_CHIP_TASK_STACK_SIZE=15360
CONFIG_CHIP_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=2
CONFIG_ESP_MATTER_NVS_USE_COMPACT_ATTR_STORAGE=y
CONFIG_WIFI_STATION_RECONNECT_INTERVAL=5000
CONFIG_MBEDTLS_HKDF_C=y

# ---------------------------------------------------------------------------
# Bluetooth LE commissioning (CHIPoBLE, NimBLE peripheral only). Phone apps (Google Home,
# Apple Home, SmartThings, Alexa, Home Assistant) look for new Matter devices over BLE and hand
# them the home Wi-Fi credentials; on-network (DNS-SD) commissioning keeps working as well.
# ---------------------------------------------------------------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_ENABLE_CHIPOBLE=y
# Keep BLE alive after commissioning: Fabric B (this device's own commissioner fabric) is always
# in the fabric table, and with the default (y) esp-matter would shut BLE down at every boot, so
# BOOT x2 could never advertise again.
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=n
# Advertising only while a commissioning window is open (BOOT x2 / first boot / web page).
CONFIG_CHIPOBLE_ENABLE_ADVERTISING_AUTOSTART=0
# Peripheral + broadcaster are all CHIPoBLE needs (the sensor is paired on-network, never over BLE).
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
# Legacy advertising: what every commissioner scans for.
CONFIG_BT_NIMBLE_EXT_ADV=n
# NimBLE host buffers in PSRAM: internal RAM stays for Wi-Fi, lwIP and the BLE controller.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120

# ---------------------------------------------------------------------------
# IPv6 for Matter-over-Thread sensors behind an existing Thread Border Router
# (Route Information Option handled by connectedhomeip ESP32RouteHook)
# ---------------------------------------------------------------------------
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_MAX_SOCKETS=16

# ---------------------------------------------------------------------------
# Wi-Fi SoftAP for the configuration portal (AP+STA)
# ---------------------------------------------------------------------------
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# ---------------------------------------------------------------------------
# RMT: keep IR timing intact while flash cache is disabled (NVS writes)
# ---------------------------------------------------------------------------
CONFIG_RMT_TX_ISR_CACHE_SAFE=y
CONFIG_RMT_RX_ISR_CACHE_SAFE=y
CONFIG_RMT_RECV_FUNC_IN_IRAM=y

# Status LED: on-board addressable RGB LED (ESP32-S3-DevKitC-1 v1.0 / most N16R8 boards: GPIO48,
# DevKitC-1 v1.1: GPIO38). Blinks blue in Matter pairing mode (BOOT x2).
CONFIG_APP_STATUS_LED_WS2812=y
CONFIG_APP_STATUS_LED_GPIO=48

# Configuration Wi-Fi (SoftAP) password, fixed for all devices built with this configuration.
CONFIG_APP_AP_PASSWORD="69696969"
