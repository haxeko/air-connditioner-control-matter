# ---------------------------------------------------------------------------
# Target / flash / PSRAM: ESP32-S3 N16R8 (16 MB QIO flash, 8 MB octal PSRAM)
# ---------------------------------------------------------------------------
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ---------------------------------------------------------------------------
# Matter: server (thermostat) + commissioner on the same CHIP stack
# ---------------------------------------------------------------------------
CONFIG_ESP_MATTER_ENABLE_MATTER_SERVER=y
# Builds connectedhomeip src/controller (DeviceCommissioner, AutoCommissioner, ...).
# ESP_MATTER_COMMISSIONER_ENABLE is NOT used: its Kconfig depends on !ESP_MATTER_ENABLE_MATTER_SERVER.
CONFIG_ENABLE_CHIP_CONTROLLER_BUILD=y
CONFIG_ESP_MATTER_CONTROLLER_ENABLE=n
# Required: CHIP_CONFIG_UNSAFE_SUBSCRIPTION_EXCHANGE_MANAGER_USE (set in matter_project_config.h)
# dereferences a null ExchangeManager for *resumed* subscriptions, so persistence must be off.
CONFIG_ENABLE_PERSIST_SUBSCRIPTIONS=n
CONFIG_CHIP_PROJECT_CONFIG="main/matter_project_config.h"

# Unique per-device setup passcode/discriminator generated on first boot (see device_identity.cpp)
CONFIG_CUSTOM_COMMISSIONABLE_DATA_PROVIDER=y
# Test DAC (uncertified product). Use esp-matter-mfg-tool + factory partition for real DACs.
CONFIG_EXAMPLE_DAC_PROVIDER=y

# Commissioning window is opened by the application (only when no home fabric exists).
CONFIG_CHIP_ENABLE_PAIRING_AUTOSTART=n

CONFIG_MAX_FABRICS=6
CONFIG_MAX_EXCHANGE_CONTEXTS=16
CONFIG_MAX_UNSOLICITED_MESSAGE_HANDLERS=10
CONFIG_NUM_UDP_ENDPOINTS=20
CONFIG_CHIP_TASK_STACK_SIZE=15360
CONFIG_CHIP_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=2
CONFIG_ESP_MATTER_NVS_USE_COMPACT_ATTR_STORAGE=y
CONFIG_WIFI_STATION_RECONNECT_INTERVAL=5000
CONFIG_MBEDTLS_HKDF_C=y

# No BLE: the device joins Wi-Fi via the SoftAP web UI and is commissioned on-network.
CONFIG_BT_ENABLED=n

# ---------------------------------------------------------------------------
# IPv6 for Matter-over-Thread sensors behind an existing Thread Border Router
# (Route Information Option handled by connectedhomeip ESP32RouteHook)
# ---------------------------------------------------------------------------
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_MAX_SOCKETS=16

# ---------------------------------------------------------------------------
# Wi-Fi SoftAP for the configuration portal (AP+STA)
# ---------------------------------------------------------------------------
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# ---------------------------------------------------------------------------
# RMT: keep IR timing intact while flash cache is disabled (NVS writes)
# ---------------------------------------------------------------------------
CONFIG_RMT_TX_ISR_CACHE_SAFE=y
CONFIG_RMT_RX_ISR_CACHE_SAFE=y
CONFIG_RMT_RECV_FUNC_IN_IRAM=y
